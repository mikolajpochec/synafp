# Throwaway PAM service for testing pam_synafp.so.
#
# Generated by `make synafp-test`; install as /etc/pam.d/synafp-test.
# It names the module by absolute path so it need not be installed
# system-wide first, and no login path references it, so a broken module
# here cannot lock you out.
#
#   make pamtest synafp-test
#   sudo install -m 0644 synafp-test /etc/pam.d/synafp-test
#   sudo ./pamtest
#
auth    required    @MODULE@    debug timeout=20 retries=1
account required    @MODULE@
