# synafp - grant the logged-in user access to Synaptics match-on-chip
# fingerprint sensors, so the driver does not need to run as root.
#
# uaccess hands the device to whoever is on the active local seat, which is
# what systemd-logind based distros expect. The plugdev fallback covers
# systems without logind.
#
# Install to /usr/lib/udev/rules.d/ (or /etc/udev/rules.d/), then:
#   udevadm control --reload-rules && udevadm trigger --subsystem-match=usb

SUBSYSTEM!="usb", GOTO="synafp_end"
ACTION!="add", GOTO="synafp_end"

ATTR{idVendor}=="06cb", ATTR{bDeviceClass}=="ff", TAG+="uaccess", \
    MODE="0660", GROUP="plugdev", ENV{ID_FINGERPRINT_READER}="1"

LABEL="synafp_end"
