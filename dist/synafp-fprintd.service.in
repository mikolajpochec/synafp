[Unit]
Description=synafp fingerprint service (fprintd-compatible)
Documentation=man:synafp(1)
# Only one process can own net.reactivated.Fprint.
Conflicts=fprintd.service open-fprintd.service

[Service]
Type=dbus
BusName=net.reactivated.Fprint
ExecStart=@LIBEXECDIR@/synafp-fprintd
Restart=on-failure
RestartSec=2

# Deliberately minimal. This service must be root to read the DMI serial and
# claim the USB device, so a sandbox buys little, and tightening it has twice
# broken the sensor path in ways that looked like driver bugs. The scanning
# itself happens in a short-lived unprivileged child.
NoNewPrivileges=no
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
